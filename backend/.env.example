# Browserbase — the real browser agents. Free tier is 3 concurrent browsers and
# 1 browser-hour PER ACCOUNT, so pooling several keys buys proportionally more
# real agents. Comma-separated, no spaces. Each key spends its own account's
# quota. BROWSERBASE_API_KEY (singular) still works for one key.
BROWSERBASE_API_KEYS=
BROWSERBASE_API_KEY=

# Cloudflare AI Gateway — persona generation and findings.
# CLOUDFLARE_API_TOKEN must be an **AI Gateway token** (permission: AI Gateway
# Run), created in the gateway's Settings, NOT a general Cloudflare API token.
# CLOUDFLARE_GATEWAY_ID is the gateway's real name, not necessarily 'default'.
# The Anthropic key itself lives in the gateway via BYOK.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_GATEWAY_ID=default
# Bare Anthropic model id (no anthropic/ prefix on this endpoint).
# claude-sonnet-5 is ~2.5x cheaper than claude-opus-5 and a few seconds
# faster per run; both produce five well-evidenced findings on a test store.
HAPPY2_MODEL=claude-sonnet-5

# Pause between stages for a real agent, in ms. 0 in normal use; set ~1500 to
# make the Browserbase live view watchable during a demo.
HAPPY2_STAGE_DELAY_MS=0

# How many of the 10 agents really drive a browser. Defaults to 3 per key, so
# with three pooled keys you get 9 real agents and 1 scripted.
HAPPY2_REAL_AGENTS=
