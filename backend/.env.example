# Browserbase — the real browser agents. Free tier is 3 concurrent browsers and
# 1 browser-hour PER ACCOUNT, so pooling several keys buys proportionally more
# real agents. Comma-separated, no spaces. Each key spends its own account's
# quota. BROWSERBASE_API_KEY (singular) still works for one key.
BROWSERBASE_API_KEYS=
BROWSERBASE_API_KEY=

# Cloudflare AI — persona generation, findings, search, and surface critiques.
# CLOUDFLARE_API_TOKEN needs Account > Workers AI > Read. Third-party models
# are billed through Cloudflare Unified Billing, so the account needs credits.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Provider-prefixed model id for the account REST messages endpoint.
HAPPY2_MODEL=anthropic/claude-sonnet-4-5

# Pause between stages for a real agent, in ms. 0 in normal use; set ~1500 to
# make the Browserbase live view watchable during a demo.
HAPPY2_STAGE_DELAY_MS=0

# How many of the 10 agents really drive a browser. Defaults to 3 per key, so
# with three pooled keys you get 9 real agents and 1 scripted.
HAPPY2_REAL_AGENTS=

# Port the API listens on.
PORT=3201

# Logging. LOG_LEVEL filters by severity; LOG_HTTP=0 silences the per-request
# lines, which are noisy during a run but useful when debugging one.
LOG_LEVEL=info
LOG_HTTP=1
