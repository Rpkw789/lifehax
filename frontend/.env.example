# Where the browser reaches the backend. Must be reachable from the USER'S
# browser, not from the Next server — this is a NEXT_PUBLIC_ variable, so it is
# inlined into the client bundle at build time, not read at runtime.
#
# Leave unset for local development; the code defaults to http://localhost:3201.
# Set it for any deployment where the API is not on that origin.
NEXT_PUBLIC_API_BASE=http://localhost:3201
